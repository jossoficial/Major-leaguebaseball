# Runtime configuration
MLB_ENV=development
MLB_LOG_LEVEL=INFO
MLB_LOG_JSON=false
MLB_API_TIMEOUT=15
MLB_API_MAX_RETRIES=3
MLB_API_RATE_LIMIT_SLEEP=0.35

# Optional: override paths inside the container or deployment environment
# MLB_CACHE_DIR=.cache
# MLB_DATA_DIR=data
# MLB_REPORTS_DIR=reports
# MLB_MODELS_DIR=models
